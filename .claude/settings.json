{
    "permissions": {
        "allow": [
            "Bash(docker exec bjornarhagen-no:*)",
            "Bash(docker ps:*)",
            "Bash(docker logs bjornarhagen-no:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(ls:*)",
            "Bash(find:*)",
            "Bash(rg:*)",
            "Bash(grep:*)",
            "Bash(jq:*)",
            "Bash(wc:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "FILE=$(jq -r '.tool_input.file_path // empty'); case \"$FILE\" in *.ts|*.tsx|*.css|*.json|*.mjs|*.md) docker exec bjornarhagen-no bunx prettier --write \"/app/${FILE#${CLAUDE_PROJECT_DIR}/}\" >/dev/null 2>&1 || true ;; esac"
                    }
                ]
            }
        ]
    }
}
