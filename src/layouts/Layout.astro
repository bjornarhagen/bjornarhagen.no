---
import Footer from "../components/smart/Footer.astro";
import Nav from "../components/smart/Nav.astro";
import StatusBar from "../components/smart/StatusBar.astro";
import "@/styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    cwd?: string;
    marginForNav?: boolean;
    marginForFooter?: boolean;
}

const defaultTitle = "Bjørnar Hagen";

const {
    title = defaultTitle,
    description = "Software engineer",
    image = "/image.jpg",
    cwd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link
            rel="preload"
            href="/fonts/jetbrains-mono/jetbrains-mono-400-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            href="/fonts/ibm-plex-sans/ibm-plex-sans-400-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            href="/fonts/pirata-one/pirata-one.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />

        <link
            href="/fonts/jetbrains-mono/jetbrains-mono.css"
            rel="stylesheet"
        />
        <link
            href="/fonts/ibm-plex-sans/ibm-plex-sans.css"
            rel="stylesheet"
        />
        <link href="/fonts/pirata-one/pirata-one.css" rel="stylesheet" />

        <meta property="og:site_name" content="Bjørnar Hagen" />
        <meta property="og:locale" content="en_US" />
        <meta http-equiv="Permissions-Policy" content="interest-cohort=()" />

        <title>
            {title === defaultTitle ? title : `${title} | ${defaultTitle}`}
        </title>

        <meta name="description" content={description} />
        <meta property="og:description" content={description} />

        <meta property="og:image" content={image} />

        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/manifest.json" />
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
        <meta name="theme-color" content="#000000" />

        <meta name="generator" content={Astro.generator} />
    </head>
    <body class="min-h-screen page-shell" id="top">
        <StatusBar position="top" cwd={cwd} />
        <Nav />
        <main class="page-main">
            <slot />
        </main>
        <Footer />
    </body>
</html>
