---
import logo from "../../../public/images/brand/logo/emblem.svg?raw";
import Icon from "../dumb/Icon.astro";
import { Menu, Search, X, Sun, MoonStar } from "lucide";
import Dialog from "../dumb/Dialog.astro";
import DialogTrigger from "../dumb/DialogTrigger.astro";

const isDevEnv = process.env.NODE_ENV === "development";

function urlIsActive(path: string) {
    return Astro.url.pathname === path;
}
function subUrlIsActive(path: string) {
    return Astro.url.pathname.startsWith(path);
}
---

<header id="nav" class="bjnav">
    <div class="left">
        <a href="/" class="brand" aria-label="bjornar.dev — home">
            <span class="brand-emblem svg-fragment">
                <Fragment set:html={logo} />
            </span>
            <span class="brand-wordmark">HB</span>
        </a>
    </div>

    <nav class="links" aria-label="primary">
        <a
            href="/entries"
            class:list={["link", { active: subUrlIsActive("/entries") }]}
            >Posts</a
        >
        <a
            href="/portfolio-tmp"
            class:list={["link", { active: subUrlIsActive("/portfolio") }]}
            >Portfolio</a
        >
        <a
            href="/about"
            class:list={["link", { active: urlIsActive("/about") }]}>About</a
        >
    </nav>

    <div class="right">
        <span class="kv search-hint">
            <span class="k">SEARCH</span>
            <span class="v">
                <span class="kbd">⌘</span>
                <span class="kbd">K</span>
            </span>
        </span>
        <button
            data-theme-toggle-trigger
            title="Switch theme"
            type="button"
            class="iconbtn"
        >
            <Icon class="theme-dark" icon={MoonStar} />
            <Icon class="theme-light" icon={Sun} />
        </button>
        <DialogTrigger dialogId="nav-search">
            <button
                data-search-open-trigger
                title="Open search"
                type="button"
                class="iconbtn"
            >
                <Icon icon={Search} />
            </button>
        </DialogTrigger>
        <DialogTrigger dialogId="nav-menu">
            <button title="Open menu" type="button" class="iconbtn">
                <Icon icon={Menu} />
            </button>
        </DialogTrigger>
    </div>
</header>

<Dialog dialogId="nav-menu" closeOnBackdropClick={true}>
    <div class="relative flex flex-col w-full h-full">
        <a href="/" class="dialog-brand">
            <span class="brand-emblem svg-fragment">
                <Fragment set:html={logo} />
            </span>
            <span>HB</span>
        </a>
        <div class="dialog-links">
            <a href="/entries">Posts</a>
            <a href="/portfolio-tmp">Portfolio</a>
            <a href="/now">/now</a>
            <a href="/about">About</a>
            {
                isDevEnv && (
                    <>
                        <a href="/kitchen-sink">Kitchen Sink</a>
                        <a href="/editor-load-entry">Editor</a>
                    </>
                )
            }
        </div>
        <div class="dialog-foot">
            <DialogTrigger dialogId="nav-menu" action="close">
                <button class="btn">
                    <Icon icon={X} />
                    <span>Close</span>
                </button>
            </DialogTrigger>
        </div>
    </div>
</Dialog>

<Dialog dialogId="nav-search" closeOnBackdropClick={true}>
    <div class="relative flex flex-col w-full h-full">
        <a href="/" class="dialog-brand">
            <span class="brand-emblem svg-fragment">
                <Fragment set:html={logo} />
            </span>
            <span>HB</span>
        </a>
        <form class="dialog-search" action="/search">
            <span class="prompt">›</span>
            <input
                name="q"
                type="search"
                placeholder="grep site ..."
                autofocus
            />
            <button type="submit" class="btn primary">
                <Icon icon={Search} />
                <span>Search</span>
            </button>
        </form>
        <div class="dialog-foot">
            <DialogTrigger dialogId="nav-search" action="close">
                <button class="btn">
                    <Icon icon={X} />
                    <span>Close</span>
                </button>
            </DialogTrigger>
        </div>
    </div>
</Dialog>

<style>
    .bjnav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--s-5);
        padding: 14px var(--gutter);
        border-bottom: 1px solid var(--border-token);
        background: var(--bg);
        position: relative;
        z-index: 10;
    }
    .left {
        justify-self: start;
        display: flex;
        align-items: center;
        gap: var(--s-4);
    }
    .right {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: var(--s-4);
    }
    .links {
        display: flex;
        align-items: center;
        gap: var(--s-5);
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--fg);
    }
    .brand:hover {
        color: var(--amber);
        text-decoration: none;
    }
    .brand-emblem {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: currentColor;
    }
    .brand-wordmark {
        font: 400 32px / 1 var(--font-display);
        letter-spacing: 0.01em;
    }
    .link {
        font: 500 var(--t-mono-sm) / 1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--fg-1);
        text-decoration: none;
    }
    .link:hover {
        color: var(--amber);
        text-decoration: none;
    }
    .link.active {
        color: var(--amber);
    }
    .search-hint {
        display: none;
    }
    @media (min-width: 960px) {
        .search-hint {
            display: inline-flex;
        }
    }
    .iconbtn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--fg-1);
        cursor: pointer;
        padding: 0;
    }
    .iconbtn:hover {
        border-color: var(--amber);
        color: var(--amber);
    }
    .iconbtn :global(svg) {
        width: 16px;
        height: 16px;
    }
    :global(.theme-dark) {
        display: none;
    }
    :global(.theme-light) {
        display: block;
    }
    :global(:root.dark .theme-dark) {
        display: block;
    }
    :global(:root.dark .theme-light) {
        display: none;
    }

    @media (max-width: 720px) {
        .links {
            display: none;
        }
        .bjnav {
            grid-template-columns: 1fr auto;
        }
    }

    /* dialogs */
    .dialog-brand {
        margin: var(--s-6) auto var(--s-7);
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font: 400 56px / 1 var(--font-display);
        color: var(--fg);
        text-decoration: none;
    }
    .dialog-brand:hover {
        color: var(--amber);
        text-decoration: none;
    }
    .dialog-brand .brand-emblem {
        width: 48px;
        height: 48px;
    }
    .dialog-links {
        margin: auto;
        display: flex;
        flex-direction: column;
        gap: var(--s-3);
        text-align: center;
    }
    .dialog-links a {
        font: 500 var(--t-mono-base) / 1 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--fg);
        text-decoration: none;
    }
    .dialog-links a:hover {
        color: var(--amber);
        text-decoration: none;
    }
    .dialog-foot {
        margin: auto auto var(--s-7);
    }
    .dialog-search {
        margin: auto auto;
        display: flex;
        gap: var(--s-3);
        align-items: center;
        border: 1px solid var(--border-strong);
        background: var(--bg-1);
        padding: 0 12px;
        height: 48px;
        width: min(560px, 90%);
    }
    .dialog-search .prompt {
        color: var(--amber);
        font: 500 var(--t-mono-md) / 1 var(--font-mono);
    }
    .dialog-search input {
        flex: 1;
        background: transparent;
        border: 0;
        outline: 0;
        color: var(--fg);
        font: 400 var(--t-mono-md) / 1 var(--font-mono);
    }
</style>

<script>
    (function () {
        setupTheme();
    })();

    function setupTheme() {
        initialize();

        const themeToggleButtons = document.querySelectorAll(
            "[data-theme-toggle-trigger]",
        );
        themeToggleButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const savedTheme = localStorage.getItem("theme");
                applyTheme(savedTheme === "light" ? "dark" : "light");
            });
        });

        function initialize() {
            const preferredTheme = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches
                ? "dark"
                : "light";
            const savedTheme = localStorage.getItem("theme");

            if (!savedTheme) {
                localStorage.setItem("theme", preferredTheme);
                applyTheme(preferredTheme);
            } else {
                applyTheme(savedTheme as "light" | "dark");
            }
        }

        function applyTheme(theme: "light" | "dark") {
            document.documentElement.classList.remove("dark");
            document.documentElement.classList.remove("light");
            document.documentElement.classList.add(theme);
            localStorage.setItem("theme", theme);
        }
    }
</script>
