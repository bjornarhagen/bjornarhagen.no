---
interface Props {
    position?: "top" | "bottom";
    cwd?: string;
}

const { position = "top", cwd } = Astro.props;

const pathname = Astro.url.pathname;

function pathToCwd(path: string): string {
    if (path === "/") return "~/home";
    let p = path.replace(/\/$/, "");
    p = p.replace(/^\/entries/, "/posts");
    return "~" + p;
}

const resolvedCwd = cwd ?? pathToCwd(pathname);
---

{
    position === "top" ? (
        <div class="status-bar">
            <span>
                <span class="dot" />{" "}
                <span class="live">SIGNAL OK</span>
            </span>
            <span class="sep">::</span>
            <span class="hidden-sm">bjornar.dev / v7.0.0</span>
            <span class="sep hidden-sm">::</span>
            <span>{resolvedCwd}</span>
            <span class="spacer" />
            <span class="hidden-md">SANDEFJORD, NO · 59.13°N</span>
            <span class="sep hidden-md">::</span>
            <span data-clock>00:00:00 UTC</span>
            <span class="sep hidden-md">::</span>
            <span class="hidden-md">NODE-04</span>
        </div>
    ) : (
        <div class="status-bar bottom">
            <span>
                <span class="dot" />{" "}
                <span class="live">UPLINK STABLE</span>
            </span>
            <span class="sep">::</span>
            <span class="hidden-sm">
                <slot name="bottom-info">deployed via vercel</slot>
            </span>
            <span class="spacer" />
            <span class="hidden-sm">
                <a href="#top">↑ to top</a>
            </span>
            <span class="sep hidden-sm">::</span>
            <span>
                press <span class="kbd">?</span> for help
            </span>
        </div>
    )
}

<style>
    .hidden-sm {
        display: none;
    }
    .hidden-md {
        display: none;
    }
    @media (min-width: 720px) {
        .hidden-sm {
            display: inline;
        }
    }
    @media (min-width: 1024px) {
        .hidden-md {
            display: inline;
        }
    }
</style>

<script>
    function tickClocks() {
        const now = new Date();
        const hh = String(now.getUTCHours()).padStart(2, "0");
        const mm = String(now.getUTCMinutes()).padStart(2, "0");
        const ss = String(now.getUTCSeconds()).padStart(2, "0");
        const txt = `${hh}:${mm}:${ss} UTC`;
        document
            .querySelectorAll<HTMLElement>("[data-clock]")
            .forEach((el) => {
                el.textContent = txt;
            });
    }
    tickClocks();
    setInterval(tickClocks, 1000);
</script>
