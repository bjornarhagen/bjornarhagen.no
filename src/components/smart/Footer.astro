---
import Rule from "../dumb/Rule.astro";
import logo from "../../../public/images/brand/logo/emblem.svg?raw";

const year = new Date().getFullYear();
---

<footer id="footer" class="bjfooter" data-grid-block>
    <div data-grid-measure>
        <Rule class="signoff-rule">
            <span>signoff</span>
            <span>· EOF ·</span>
            <span>0xHB</span>
        </Rule>
        <div class="container-x">
            <div class="signoff-grid">
                <div class="brand-block">
                    <a href="/" class="footer-logo svg-fragment" aria-label="bjornar.dev — home">
                        <span class="footer-emblem" aria-hidden="true"><Fragment set:html={logo} /></span>
                        <span class="footer-wordmark" aria-hidden="true">HB</span>
                    </a>
                    <div class="tagline">
                        // Embrace the chaos · &copy; 2012&ndash;{year}
                    </div>
                </div>
                <div class="link-cols">
                    <div>
                        <div class="col-head">// channels</div>
                        <div>
                            <a
                                href="https://github.com/bjornarhagen"
                                target="_blank"
                                rel="noopener"
                            >
                                GitHub
                            </a>
                        </div>
                        <div>
                            <a
                                href="https://linkedin.com/in/bjornarhagen"
                                target="_blank"
                                rel="noopener"
                            >
                                LinkedIn
                            </a>
                        </div>
                        <div>
                            <a
                                href="https://twitter.com/bjornarhagen"
                                target="_blank"
                                rel="noopener"
                            >
                                X
                            </a>
                        </div>
                    </div>
                    <div>
                        <div class="col-head">// system</div>
                        <div>
                            <a href="/rss.xml">RSS feed</a>
                        </div>
                        <div>
                            <a href="/about#colophon">Colophon</a>
                        </div>
                        <div>
                            <a
                                href="https://github.com/bjornarhagen/bjornarhagen.no"
                                target="_blank"
                                rel="noopener"
                            >
                                Source
                            </a>
                        </div>
                        <div>
                            <a
                                href="https://webring.xxiivv.com/"
                                target="_blank"
                                rel="noopener"
                            >
                                xxiivv ring
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    .bjfooter {
        margin-top: var(--s-9);
    }
    .container-x {
        padding-bottom: var(--s-7);
    }
    .bjfooter :global(.signoff-rule) {
        margin: var(--s-8) 0 0;
    }
    .signoff-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s-7);
        align-items: end;
    }
    @media (min-width: 800px) {
        .signoff-grid {
            grid-template-columns: 1fr auto;
        }
    }
    .brand-block {
        display: flex;
        align-items: center;
        gap: var(--s-5);
    }
    @media (max-width: 1023px) {
        .brand-block {
            flex-direction: column;
            align-items: center;
            gap: var(--s-4);
            text-align: center;
        }
    }
    .tagline {
        font: 500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-dim);
        text-transform: uppercase;
        letter-spacing: 0.16em;
    }
    .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: var(--s-4);
        flex-shrink: 0;
        color: var(--fg);
    }
    .footer-emblem {
        display: block;
        width: var(--s-8);
    }
    .footer-wordmark {
        font: 400 56px / 1 var(--font-display);
        letter-spacing: 0.01em;
    }
    .footer-logo:hover {
        color: var(--amber);
        text-decoration: none;
    }
    .link-cols {
        display: grid;
        grid-template-columns: repeat(2, auto);
        gap: var(--s-5) var(--s-7);
        font: 500 var(--t-mono-sm) / 1.8 var(--font-mono);
    }
    @media (max-width: 600px) {
        .link-cols {
            grid-template-columns: 1fr 1fr;
        }
    }
    .col-head {
        color: var(--fg-muted);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 11px;
        margin-bottom: 10px;
    }
    .link-cols a {
        color: var(--fg-1);
        text-decoration: none;
    }
    .link-cols a:hover {
        color: var(--amber);
    }
</style>
