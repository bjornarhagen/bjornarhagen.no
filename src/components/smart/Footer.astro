---
import StatusBar from "./StatusBar.astro";

const year = new Date().getFullYear();
---

<footer id="footer" class="bjfooter">
    <div class="container-x">
        <div class="rule signoff-rule">
            <span>signoff</span>
            <span>· EOF ·</span>
            <span>0xHB</span>
        </div>
        <div class="signoff-grid">
            <div class="brand-block">
                <div class="wordmark">
                    bjornar<span class="dot">.</span>dev
                </div>
                <div class="tagline">
                    // keep the lights on · &copy; 2009&ndash;{year}
                </div>
            </div>
            <div class="link-cols">
                <div>
                    <div class="col-head">// nav</div>
                    <div><a href="/entries">Posts</a></div>
                    <div><a href="/portfolio-tmp">Portfolio</a></div>
                    <div><a href="/now">/now</a></div>
                    <div><a href="/about">About</a></div>
                </div>
                <div>
                    <div class="col-head">// channels</div>
                    <div>
                        <a
                            href="https://github.com/bjornarhagen"
                            target="_blank"
                            rel="noopener">GitHub</a
                        >
                    </div>
                    <div>
                        <a
                            href="https://linkedin.com/in/bjornarhagen"
                            target="_blank"
                            rel="noopener">LinkedIn</a
                        >
                    </div>
                    <div>
                        <a
                            href="https://twitter.com/bjornarhagen"
                            target="_blank"
                            rel="noopener">X</a
                        >
                    </div>
                    <div>
                        <a href="mailto:post@bjornarhagen.no">Email</a>
                    </div>
                </div>
                <div>
                    <div class="col-head">// system</div>
                    <div><a href="/rss.xml">RSS feed</a></div>
                    <div><a href="/about">Colophon</a></div>
                    <div>
                        <a
                            href="https://github.com/bjornarhagen/bjornarhagen.no"
                            target="_blank"
                            rel="noopener">Source</a
                        >
                    </div>
                    <div>
                        <a
                            href="https://webring.xxiivv.com/"
                            target="_blank"
                            rel="noopener">xxiivv ring</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
    <StatusBar position="bottom" />
</footer>

<style>
    .bjfooter {
        border-top: 1px solid var(--border-token);
        margin-top: var(--s-9);
    }
    .container-x {
        padding-top: var(--s-7);
        padding-bottom: var(--s-7);
    }
    .signoff-rule {
        margin-bottom: var(--s-5);
    }
    .signoff-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s-7);
        align-items: end;
    }
    @media (min-width: 800px) {
        .signoff-grid {
            grid-template-columns: 1fr auto;
        }
    }
    .wordmark {
        font:
            400 88px / 0.9 var(--font-display);
        color: var(--fg);
        letter-spacing: 0.005em;
    }
    @media (max-width: 720px) {
        .wordmark {
            font-size: 64px;
        }
    }
    .wordmark .dot {
        color: var(--amber);
    }
    .tagline {
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-dim);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        margin-top: var(--s-4);
    }
    .link-cols {
        display: grid;
        grid-template-columns: repeat(3, auto);
        gap: var(--s-5) var(--s-7);
        font:
            500 var(--t-mono-sm) / 1.8 var(--font-mono);
    }
    @media (max-width: 600px) {
        .link-cols {
            grid-template-columns: 1fr 1fr;
        }
    }
    .col-head {
        color: var(--fg-muted);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 11px;
        margin-bottom: 10px;
    }
    .link-cols a {
        color: var(--fg-1);
        text-decoration: none;
    }
    .link-cols a:hover {
        color: var(--amber);
    }
</style>
