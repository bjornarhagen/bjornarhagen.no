---
interface Props {
    title: string;
    /** When true, allocates the right-hand grid column for the `filters` slot. */
    filters?: boolean;
}

const { title, filters = false } = Astro.props;
---

<section class="header-block grid-width" data-page-header data-grid-block>
    <div
        class:list={["header-content", filters && "with-filters"]}
        data-grid-measure
    >
        <div>
            <h1 class="page-title">{title}</h1>
            <p class="lede">
                <slot />
            </p>
        </div>
        {filters && (
            <div class="filters">
                <slot name="filters" />
            </div>
        )}
    </div>
</section>

<style>
    .header-block {
        padding: var(--s-8) 0 var(--s-8);
        margin: 0 auto;
    }
    .header-content.with-filters {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--s-6);
        align-items: end;
    }
    @media (max-width: 960px) {
        .header-block {
            padding: var(--s-6) 0;
        }
        .header-content.with-filters {
            grid-template-columns: minmax(0, 1fr);
        }
        .header-content .filters {
            min-width: 0;
        }
    }
    .page-title {
        font-size: clamp(64px, 12vw, 144px);
        line-height: 0.9;
    }
    .lede {
        margin-top: var(--s-4);
        font: 400 var(--t-body-lg) / 1.5 var(--font-body);
        color: var(--fg-1);
        max-width: 56ch;
    }
    .lede :global(a) {
        color: var(--amber);
        border-bottom: 1px solid
            color-mix(in srgb, var(--amber) 40%, transparent);
    }
    .lede :global(a:hover) {
        color: var(--fg);
        border-bottom-color: var(--fg);
        text-decoration: none;
    }
    .filters {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 320px;
    }
</style>
