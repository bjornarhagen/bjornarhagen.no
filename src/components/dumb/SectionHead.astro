---
/**
 * The big heading + slot for a Rule on the right.
 * Used by WorkLog.
 */
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<div class="section-head">
    <div>
        <h3 class="big-heading">{title}</h3>
    </div>
    <slot name="rule" />
</div>

<style>
    .section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s-5);
        margin-bottom: 28px;
        flex-wrap: wrap;
    }
    .big-heading {
        font-size: 56px;
    }
    @media (max-width: 720px) {
        .big-heading {
            font-size: 40px;
        }
    }
    .section-head :global(.rule) {
        flex: 0 0 280px;
    }
    @media (max-width: 720px) {
        .section-head :global(.rule) {
            flex: 1 1 100%;
        }
    }
</style>
