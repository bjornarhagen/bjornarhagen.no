---
/**
 * Halftone "bear" silhouette portrait in pure SVG.
 * No props — colors come from CSS vars (currentColor-style).
 */
---

<svg
    class="portrait-svg"
    viewBox="0 0 220 320"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
>
    <defs>
        <pattern
            id="halftone-dense"
            width="3"
            height="3"
            patternUnits="userSpaceOnUse"
        >
            <circle cx="1.5" cy="1.5" r="1.05" fill="var(--fg)"></circle>
        </pattern>
        <pattern
            id="halftone-mid"
            width="4"
            height="4"
            patternUnits="userSpaceOnUse"
        >
            <circle cx="2" cy="2" r=".85" fill="var(--fg)"></circle>
        </pattern>
        <pattern
            id="halftone-sparse"
            width="6"
            height="6"
            patternUnits="userSpaceOnUse"
        >
            <circle cx="3" cy="3" r=".7" fill="var(--fg-dim)"></circle>
        </pattern>
        <pattern
            id="halftone-vsparse"
            width="8"
            height="8"
            patternUnits="userSpaceOnUse"
        >
            <circle cx="4" cy="4" r=".5" fill="var(--fg-muted)"></circle>
        </pattern>
        <radialGradient id="vignette" cx=".5" cy=".4" r=".7">
            <stop offset=".3" stop-color="var(--bg)" stop-opacity="0"></stop>
            <stop offset="1" stop-color="var(--bg)" stop-opacity=".8"></stop>
        </radialGradient>
    </defs>
    <rect width="220" height="320" fill="var(--bg)"></rect>
    <rect
        width="220"
        height="320"
        fill="url(#halftone-vsparse)"
        opacity=".7"></rect>
    <g transform="translate(110 170)">
        <ellipse
            cx="0"
            cy="60"
            rx="100"
            ry="80"
            fill="url(#halftone-sparse)"
            opacity=".7"></ellipse>
        <ellipse
            cx="0"
            cy="60"
            rx="86"
            ry="70"
            fill="url(#halftone-mid)"
            opacity=".75"></ellipse>
        <ellipse
            cx="0"
            cy="60"
            rx="60"
            ry="50"
            fill="url(#halftone-dense)"
            opacity=".55"></ellipse>
        <circle
            cx="0"
            cy="-20"
            r="62"
            fill="url(#halftone-sparse)"
            opacity=".75"></circle>
        <circle
            cx="0"
            cy="-20"
            r="50"
            fill="url(#halftone-mid)"
            opacity=".8"></circle>
        <circle
            cx="0"
            cy="-20"
            r="38"
            fill="url(#halftone-dense)"
            opacity=".55"></circle>
        <circle
            cx="-44"
            cy="-58"
            r="16"
            fill="url(#halftone-mid)"
            opacity=".9"></circle>
        <circle
            cx="44"
            cy="-58"
            r="16"
            fill="url(#halftone-mid)"
            opacity=".9"></circle>
        <circle
            cx="-44"
            cy="-58"
            r="10"
            fill="url(#halftone-dense)"
            opacity=".7"></circle>
        <circle
            cx="44"
            cy="-58"
            r="10"
            fill="url(#halftone-dense)"
            opacity=".7"></circle>
        <ellipse
            cx="0"
            cy="10"
            rx="22"
            ry="16"
            fill="url(#halftone-mid)"
            opacity=".95"></ellipse>
        <ellipse cx="0" cy="6" rx="6" ry="4" fill="var(--bg)"></ellipse>
        <circle cx="-16" cy="-26" r="2.4" fill="var(--bg)"></circle>
        <circle cx="16" cy="-26" r="2.4" fill="var(--bg)"></circle>
    </g>
    <rect width="220" height="320" fill="url(#vignette)"></rect>
    <g stroke="var(--fg)" stroke-width="1" fill="none">
        <path d="M8 8 h14 M8 8 v14"></path>
        <path d="M212 8 h-14 M212 8 v14"></path>
        <path d="M8 312 h14 M8 312 v-14"></path>
        <path d="M212 312 h-14 M212 312 v-14"></path>
    </g>
    <g stroke="var(--amber)" stroke-width="1" fill="none" opacity=".7">
        <circle cx="110" cy="150" r="22"></circle>
        <path d="M110 116 v18 M110 184 v-18 M76 150 h18 M144 150 h-18"></path>
    </g>
</svg>
