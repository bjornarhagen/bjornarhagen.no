---
import Rule from "./Rule.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
    date?: string;
}

const { date } = Astro.props;
---

<div class="signoff">
    <Rule class="signoff-rule">
        <span>signoff</span>
        <span>· 0xHB ·</span>
        {date && <span>{date}</span>}
    </Rule>
    <div class="wm">
        <Wordmark size="md" />
    </div>
    <div class="signoff-text">
        <slot>// typed in Sandefjord, Norway</slot>
    </div>
</div>

<style>
    .signoff {
        margin-top: var(--s-7);
        text-align: center;
        font:
            400 var(--t-mono-sm) / 1.6 var(--font-mono);
        color: var(--fg-muted);
    }
    :global(.signoff-rule) {
        margin-bottom: 28px;
    }
    .wm {
        margin: 18px 0 24px;
    }
    .signoff-text {
        max-width: 56ch;
        margin: 0 auto;
    }
</style>
