---
import Rule from "./Rule.astro";
import Btn from "./Btn.astro";
import Dossier from "./Dossier.astro";

type Meta = { k: string; v: string; tone?: "default" | "ok" };

interface Props {
    firstName?: string;
    lastName?: string;
    role?: string;
    metas?: Meta[];
}

const {
    firstName = "Bjørnar",
    lastName = "Hagen",
    role = "// Software Engineer  ·  Builder  ·  Bear-adjacent",
    metas = [
        { k: "Active", v: "14y · 02mo", tone: "ok" },
        { k: "Posted", v: "@ Gokstad" },
        { k: "Stack", v: "TS · PHP · Astro" },
        { k: "Based", v: "Sandefjord, NO" },
    ],
} = Astro.props;
---

<section class="hero">
    <div class="hero-left">
        <Rule class="mb-rule">
            <span>identity</span>
            <span>· 01 ·</span>
            <span>operator profile</span>
        </Rule>

        <h1 class="hero-title">
            <span>{firstName}</span><br />
            <span>{lastName}</span><span class="dot">.</span>
        </h1>
        <div class="role" set:html={role} />

        <p class="lede">
            <slot name="lede">
                I build, break and occasionally fix systems on the open web —
                full-stack, infrastructure, the slightly haunted parts in
                between.
            </slot>
        </p>

        <div class="cta-row">
            <slot name="cta">
                <Btn href="/entries" variant="primary">Read posts</Btn>
                <Btn href="/portfolio-tmp">Portfolio</Btn>
                <Btn
                    href="mailto:post@bjornarhagen.no"
                    arrow="up-right">Contact</Btn
                >
            </slot>
        </div>

        <div class="meta-grid">
            {
                metas.map((m) => (
                    <div>
                        <div class="kv">
                            <span class="k">{m.k}</span>
                        </div>
                        <div class:list={["meta-v", m.tone === "ok" && "ok"]}>
                            {m.v}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <Dossier />
</section>

<style>
    .hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: var(--s-7);
        padding: var(--s-8) var(--gutter) var(--s-9);
        align-items: stretch;
        border-bottom: 1px solid var(--border-token);
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
    }
    @media (max-width: 960px) {
        .hero {
            grid-template-columns: 1fr;
            gap: var(--s-6);
            padding: var(--s-6) var(--gutter) var(--s-7);
        }
    }
    .mb-rule {
        margin-bottom: 28px;
    }
    .hero-title {
        font-size: clamp(72px, 12vw, 132px);
        line-height: 0.92;
        letter-spacing: 0.005em;
    }
    .hero-title .dot {
        color: var(--amber);
    }
    .role {
        margin-top: var(--s-3);
        font:
            500 var(--t-mono-md) / 1.4 var(--font-mono);
        color: var(--amber);
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }
    .lede {
        margin-top: var(--s-5);
        font-size: 19px;
        line-height: 1.55;
        color: var(--fg-1);
        max-width: 38ch;
    }
    .lede :global(a) {
        color: var(--amber);
        border-bottom: 1px solid
            color-mix(in srgb, var(--amber) 40%, transparent);
    }
    .lede :global(a:hover) {
        color: var(--fg);
        border-bottom-color: var(--fg);
        text-decoration: none;
    }
    .cta-row {
        display: flex;
        gap: var(--s-3);
        margin-top: var(--s-6);
        flex-wrap: wrap;
    }
    .meta-grid {
        margin-top: var(--s-7);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border: 1px solid var(--border-token);
    }
    @media (max-width: 720px) {
        .meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .meta-grid > div {
        padding: 12px 14px;
        border-right: 1px solid var(--border-token);
        background: var(--bg-1);
    }
    .meta-grid > div:last-child {
        border-right: none;
    }
    @media (max-width: 720px) {
        .meta-grid > div:nth-child(2) {
            border-right: none;
        }
    }
    .meta-v {
        font:
            500 18px / 1 var(--font-mono);
        margin-top: 8px;
        color: var(--fg);
    }
    .meta-v.ok {
        color: var(--ok);
    }
</style>
