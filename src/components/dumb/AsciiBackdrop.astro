---
/**
 * Faint ASCII rendering of a header image, used as a section background.
 * The image is converted to glyphs client-side (canvas luminance sampling),
 * mapped by *contrast against the page background* so the subject reads in
 * both themes, with a few cells flickering at random. Swaps image on theme
 * change; static (no flicker) under prefers-reduced-motion.
 */
interface Props {
    dark?: string;
    light?: string;
    class?: string;
}
const {
    dark = "/images/graphics/black-3.webp",
    light = "/images/graphics/white-3.webp",
    class: className = "",
} = Astro.props;
---

<div
    class:list={["ascii-backdrop", className]}
    aria-hidden="true"
    data-dark={dark}
    data-light={light}
>
    <pre></pre>
</div>

<style>
    .ascii-backdrop {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        user-select: none;
        opacity: 0.15;
        -webkit-mask-image: radial-gradient(
            120% 120% at 70% 35%,
            #000 30%,
            transparent 80%
        );
        mask-image: radial-gradient(
            120% 120% at 70% 35%,
            #000 30%,
            transparent 80%
        );
    }
    .ascii-backdrop pre {
        margin: 0;
        font-family: var(--font-mono);
        color: var(--fg);
        white-space: pre;
        font-size: 12px;
        line-height: 1;
    }
</style>

<script>
    function initAsciiBackdrop(wrap: HTMLElement) {
        const pre = wrap.querySelector("pre");
        if (!pre) return;
        const cvs = document.createElement("canvas");
        const ctx = cvs.getContext("2d", { willReadFrequently: true });
        if (!ctx) return;

        const RAMP = " .:-=+*#%@";
        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const img = new Image();

        let cols = 0;
        let rows = 0;
        let baseIdx = new Int8Array(0);
        let cells: string[] = [];

        const isDark = () =>
            document.documentElement.classList.contains("dark");
        const currentSrc = () =>
            (isDark() ? wrap.dataset.dark : wrap.dataset.light) ?? "";

        function paint() {
            let out = "";
            for (let y = 0; y < rows; y++) {
                out += cells.slice(y * cols, y * cols + cols).join("") + "\n";
            }
            pre!.textContent = out;
        }

        function render() {
            const w = wrap.clientWidth;
            const h = wrap.clientHeight;
            if (!w || !h || !img.naturalWidth) return;

            cols = Math.max(40, Math.min(150, Math.round(w / 8)));
            const fontPx = w / (cols * 0.6);
            pre!.style.fontSize = fontPx + "px";
            rows = Math.max(10, Math.round(h / fontPx));
            cvs.width = cols;
            cvs.height = rows;

            // cover-crop the source so it isn't distorted
            const ia = img.naturalWidth / img.naturalHeight;
            const ta = w / h;
            let sx = 0;
            let sy = 0;
            let sw = img.naturalWidth;
            let sh = img.naturalHeight;
            if (ia > ta) {
                sw = sh * ta;
                sx = (img.naturalWidth - sw) / 2;
            } else {
                sh = sw / ta;
                sy = (img.naturalHeight - sh) / 2;
            }
            ctx!.clearRect(0, 0, cols, rows);
            ctx!.drawImage(img, sx, sy, sw, sh, 0, 0, cols, rows);
            const data = ctx!.getImageData(0, 0, cols, rows).data;

            const dark = isDark();
            const n = cols * rows;
            baseIdx = new Int8Array(n);
            cells = new Array(n);
            const last = RAMP.length - 1;
            for (let i = 0; i < n; i++) {
                const lum =
                    (0.299 * data[i * 4] +
                        0.587 * data[i * 4 + 1] +
                        0.114 * data[i * 4 + 2]) /
                    255;
                // density = how much the pixel contrasts the page background
                const density = dark ? lum : 1 - lum;
                const idx = Math.max(0, Math.min(last, Math.round(density * last)));
                baseIdx[i] = idx;
                cells[i] = RAMP[idx];
            }
            paint();
        }

        function mutate() {
            const n = cols * rows;
            if (!n) return;
            const k = Math.max(6, Math.floor(n * 0.012));
            const last = RAMP.length - 1;
            for (let j = 0; j < k; j++) {
                const i = (Math.random() * n) | 0;
                let idx = baseIdx[i] + ((Math.random() * 4) | 0) - 1;
                if (idx < 0) idx = 0;
                if (idx > last) idx = last;
                cells[i] = RAMP[idx];
            }
            paint();
        }

        function load() {
            const src = currentSrc();
            if (!src) return;
            img.onload = render;
            img.src = src;
            if (img.complete && img.naturalWidth) render();
        }

        load();
        if (!reduced) window.setInterval(mutate, 130);

        let rt = 0;
        const ro = new ResizeObserver(() => {
            window.clearTimeout(rt);
            rt = window.setTimeout(render, 120);
        });
        ro.observe(wrap);

        const mo = new MutationObserver(load);
        mo.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }

    document
        .querySelectorAll<HTMLElement>(".ascii-backdrop")
        .forEach(initAsciiBackdrop);
</script>
