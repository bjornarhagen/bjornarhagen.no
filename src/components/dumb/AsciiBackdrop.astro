---
/**
 * Faint ASCII rendering of a header image, used as a section background.
 * The image is converted to glyphs client-side (canvas luminance sampling),
 * mapped by *contrast against the page background* so the subject reads in
 * both themes, with a few cells flickering at random. Swaps image on theme
 * change; static (no flicker) under prefers-reduced-motion.
 *
 * ── Adjustable knobs (props, all optional) ───────────────────────────────
 *   color           "" → theme ink (--fg) · any CSS colour · "image" → use the
 *                   source image's own pixel colours
 *   maxCols         resolution cap — higher = more / smaller chars
 *   charAspect      monospace char width ÷ font-size (~0.6); tweaks char size
 *   ramp            glyph ramp, sparse → dense
 *   flickerMs       flicker tick interval in ms (0 disables the flicker)
 *   flickerFraction share of cells that change each tick (0–1)
 *   opacity         overlay opacity
 */
interface Props {
    dark?: string;
    light?: string;
    class?: string;
    color?: string;
    maxCols?: number;
    charAspect?: number;
    ramp?: string;
    flickerMs?: number;
    flickerFraction?: number;
    opacity?: number;
}
const {
    dark = "/images/graphics/black-3.webp",
    light = "/images/graphics/white-3.webp",
    class: className = "",
    color = "",
    maxCols = 150,
    charAspect = 0.6,
    ramp = " .:-=+*#%@",
    flickerMs = 130,
    flickerFraction = 0.012,
    opacity = 0.15,
} = Astro.props;
---

<div
    class:list={["ascii-backdrop", className]}
    aria-hidden="true"
    data-dark={dark}
    data-light={light}
    data-color={color}
    data-max-cols={maxCols}
    data-char-aspect={charAspect}
    data-ramp={ramp}
    data-flicker-ms={flickerMs}
    data-flicker-fraction={flickerFraction}
    style={`--ascii-opacity:${opacity}`}
>
    <pre></pre>
</div>

<style>
    .ascii-backdrop {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        user-select: none;
        opacity: var(--ascii-opacity, 0.15);
        -webkit-mask-image: radial-gradient(
            120% 120% at 70% 35%,
            #000 30%,
            transparent 80%
        );
        mask-image: radial-gradient(
            120% 120% at 70% 35%,
            #000 30%,
            transparent 80%
        );
    }
    .ascii-backdrop pre {
        margin: 0;
        font-family: var(--font-mono);
        color: var(--fg);
        white-space: pre;
        font-size: 12px;
        line-height: 1;
    }
</style>

<script>
    function initAsciiBackdrop(wrap: HTMLElement) {
        const pre = wrap.querySelector("pre");
        if (!pre) return;
        const cvs = document.createElement("canvas");
        const ctx = cvs.getContext("2d", { willReadFrequently: true });
        if (!ctx) return;

        const cfg = {
            color: wrap.dataset.color ?? "",
            maxCols: Number(wrap.dataset.maxCols) || 150,
            charAspect: Number(wrap.dataset.charAspect) || 0.6,
            ramp: wrap.dataset.ramp || " .:-=+*#%@",
            flickerMs: Number(wrap.dataset.flickerMs ?? 130),
            flickerFraction: Number(wrap.dataset.flickerFraction) || 0.012,
        };
        const RAMP = cfg.ramp;
        const last = RAMP.length - 1;
        const colorMode = cfg.color === "image";
        if (!colorMode && cfg.color) pre.style.color = cfg.color;

        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const img = new Image();

        let cols = 0;
        let rows = 0;
        let baseIdx = new Int8Array(0);
        let cells: string[] = [];
        let spans: HTMLCollectionOf<HTMLSpanElement> | null = null;

        const isDark = () =>
            document.documentElement.classList.contains("dark");
        const currentSrc = () =>
            (isDark() ? wrap.dataset.dark : wrap.dataset.light) ?? "";

        function render() {
            const w = wrap.clientWidth;
            const h = wrap.clientHeight;
            if (!w || !h || !img.naturalWidth) return;

            cols = Math.max(40, Math.min(cfg.maxCols, Math.round(w / 8)));
            const fontPx = w / (cols * cfg.charAspect);
            pre!.style.fontSize = fontPx + "px";
            rows = Math.max(10, Math.round(h / fontPx));
            cvs.width = cols;
            cvs.height = rows;

            // cover-crop the source so it isn't distorted
            const ia = img.naturalWidth / img.naturalHeight;
            const ta = w / h;
            let sx = 0;
            let sy = 0;
            let sw = img.naturalWidth;
            let sh = img.naturalHeight;
            if (ia > ta) {
                sw = sh * ta;
                sx = (img.naturalWidth - sw) / 2;
            } else {
                sh = sw / ta;
                sy = (img.naturalHeight - sh) / 2;
            }
            ctx!.clearRect(0, 0, cols, rows);
            ctx!.drawImage(img, sx, sy, sw, sh, 0, 0, cols, rows);
            const data = ctx!.getImageData(0, 0, cols, rows).data;

            const dark = isDark();
            const n = cols * rows;
            baseIdx = new Int8Array(n);
            cells = new Array(n);

            let html = "";
            for (let y = 0; y < rows; y++) {
                for (let x = 0; x < cols; x++) {
                    const i = y * cols + x;
                    const r = data[i * 4];
                    const g = data[i * 4 + 1];
                    const b = data[i * 4 + 2];
                    const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
                    // density = contrast against the page background
                    const density = dark ? lum : 1 - lum;
                    const idx = Math.max(0, Math.min(last, Math.round(density * last)));
                    baseIdx[i] = idx;
                    cells[i] = RAMP[idx];
                    if (colorMode) {
                        html += `<span style="color:rgb(${r},${g},${b})">${RAMP[idx]}</span>`;
                    }
                }
                if (colorMode) html += "\n";
            }

            if (colorMode) {
                pre!.innerHTML = html;
                spans = pre!.getElementsByTagName("span");
            } else {
                spans = null;
                paint();
            }
        }

        function paint() {
            let out = "";
            for (let y = 0; y < rows; y++) {
                out += cells.slice(y * cols, y * cols + cols).join("") + "\n";
            }
            pre!.textContent = out;
        }

        function mutate() {
            const n = cols * rows;
            if (!n) return;
            const k = Math.max(6, Math.floor(n * cfg.flickerFraction));
            for (let j = 0; j < k; j++) {
                const i = (Math.random() * n) | 0;
                let idx = baseIdx[i] + ((Math.random() * 4) | 0) - 1;
                if (idx < 0) idx = 0;
                if (idx > last) idx = last;
                if (colorMode) {
                    if (spans && spans[i]) spans[i].textContent = RAMP[idx];
                } else {
                    cells[i] = RAMP[idx];
                }
            }
            if (!colorMode) paint();
        }

        function load() {
            const src = currentSrc();
            if (!src) return;
            img.onload = render;
            img.src = src;
            if (img.complete && img.naturalWidth) render();
        }

        load();
        if (!reduced && cfg.flickerMs > 0) {
            window.setInterval(mutate, cfg.flickerMs);
        }

        let rt = 0;
        const ro = new ResizeObserver(() => {
            window.clearTimeout(rt);
            rt = window.setTimeout(render, 120);
        });
        ro.observe(wrap);

        const mo = new MutationObserver(load);
        mo.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }

    document
        .querySelectorAll<HTMLElement>(".ascii-backdrop")
        .forEach(initAsciiBackdrop);
</script>
