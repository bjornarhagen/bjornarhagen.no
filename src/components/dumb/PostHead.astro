---
import Bread, { type BreadItem } from "./Bread.astro";
import Rule from "./Rule.astro";
import MetaRow from "./MetaRow.astro";

type MetaItem = { k: string; v: string };

interface Props {
    bread: BreadItem[];
    title: string;
    ruleParts: string[];
    metas: MetaItem[];
    type?: string;
}

const { bread, title, ruleParts, metas, type } = Astro.props;
---

<section class="post-head">
    <Bread items={bread} caret={false} />
    <Rule class="head-rule">
        {ruleParts.map((p) => <span>{p}</span>)}
    </Rule>
    <h1 class="post-title">{title}</h1>
    <MetaRow items={metas} type={type} />
</section>

<style>
    .post-head {
        max-width: 1240px;
        margin: 0 auto;
        padding: var(--s-7) var(--gutter) var(--s-4);
    }
    .post-title {
        font-size: clamp(48px, 8vw, 96px);
        line-height: 0.94;
        margin-top: 18px;
        letter-spacing: 0.005em;
    }
    :global(.head-rule) {
        margin-top: 22px;
    }
</style>
