---
import MetaRow from "./MetaRow.astro";

type MetaItem = { k: string; v: string };

interface Props {
    title: string;
    metas: MetaItem[];
    type?: string;
}

const { title, metas, type } = Astro.props;
---

<section
    class="post-head grid-width grid-width-narrow"
    data-page-header
    data-grid-block
>
    <div data-grid-measure>
        <h1 class="post-title">{title}</h1>
        <MetaRow items={metas} type={type} />
    </div>
</section>

<style>
    .post-head {
        margin: 0 auto;
        padding: var(--s-8) 0 var(--s-6);
    }
    .post-title {
        font-size: clamp(48px, 8vw, 96px);
        line-height: 0.94;
        letter-spacing: 0.005em;
    }
</style>
