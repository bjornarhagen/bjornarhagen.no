---
interface Props {
    src: string;
    alt: string;
    tl?: string;
    tr?: string;
    bl?: string;
    br?: string;
}

const { src, alt, tl, tr, bl, br } = Astro.props;
---

<section class="post-hero">
    <div class="post-hero-inner">
        <img src={src} alt={alt} />
        {tl && <span class="corner c-tl">{tl}</span>}
        {tr && <span class="corner c-tr">{tr}</span>}
        {bl && <span class="corner c-bl">{bl}</span>}
        {br && <span class="corner c-br">{br}</span>}
    </div>
</section>

<style>
    .post-hero {
        max-width: 1240px;
        margin: 24px auto 0;
        padding: 0 var(--gutter);
    }
    .post-hero-inner {
        border: 1px solid var(--border-strong);
        position: relative;
        aspect-ratio: 21 / 9;
        overflow: hidden;
        background: var(--bg-1);
    }
    .post-hero-inner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .post-hero-inner::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(
            0deg,
            transparent 0 2px,
            rgba(0, 0, 0, 0.16) 2px 3px
        );
    }
    .corner {
        position: absolute;
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-dim);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        padding: 6px 10px;
        border: 1px solid var(--border-token);
        z-index: 2;
    }
    .c-tl {
        top: 12px;
        left: 12px;
    }
    .c-tr {
        top: 12px;
        right: 12px;
    }
    .c-bl {
        bottom: 12px;
        left: 12px;
        color: var(--amber);
    }
    .c-br {
        bottom: 12px;
        right: 12px;
    }
</style>
