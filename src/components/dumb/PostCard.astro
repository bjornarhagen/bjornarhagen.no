---
import PostThumb from "./PostThumb.astro";

interface Props {
    href: string;
    title: string;
    excerpt: string;
    date: string;
    poster?: string;
    idBadge?: string;
}

const { href, title, excerpt, date, poster, idBadge } = Astro.props;
---

<a href={href} class="post-card" data-grid-block>
    <PostThumb
        src={poster}
        alt={title}
        idBadge={idBadge}
        dateBadge={date}
    />
    <h3 class="post-title">{title}</h3>
    <p class="post-excerpt">{excerpt}</p>
</a>

<style>
    .post-card {
        min-width: 0;
        padding: var(--s-5);
        background: var(--bg);
        display: grid;
        grid-template-rows: auto auto 1fr;
        align-items: start;
        gap: var(--s-4);
        position: relative;
        transition: background 0.2s;
        text-decoration: none;
        color: inherit;
    }
    .post-card::after {
        content: "";
        position: absolute;
        inset: 0 -1px -1px 0;
        border-right: 1px solid var(--border-token);
        border-bottom: 1px solid var(--border-token);
        pointer-events: none;
        z-index: 1;
    }
    .post-card:hover {
        background: var(--bg-1);
        text-decoration: none;
    }
    .post-card:hover .post-title {
        color: var(--amber);
    }
    .post-card:hover :global(.post-thumb img) {
        filter: grayscale(0);
    }
    .post-title {
        font:
            400 32px / 1 var(--font-display);
        color: var(--fg);
        transition: color 0.15s;
        letter-spacing: 0.01em;
    }
    .post-excerpt {
        font:
            400 14px / 1.55 var(--font-body);
        color: var(--fg-1);
        margin: 0;
    }
</style>
