---
import Layout from "@/layouts/Layout.astro";
import { dynamicPages, dynamicPagesConfig } from "@/data/dynamic-pages";
import PageHeader from "@/components/dumb/PageHeader.astro";
import FilterRow from "@/components/dumb/FilterRow.astro";
import Tag from "@/components/dumb/Tag.astro";
import StatsStrip from "@/components/dumb/StatsStrip.astro";
import Rule from "@/components/dumb/Rule.astro";
import FeatureCard from "@/components/dumb/FeatureCard.astro";
import PostsGrid from "@/components/dumb/PostsGrid.astro";
import PostCard from "@/components/dumb/PostCard.astro";

const { dynamicPageType } = Astro.params;
const pages = dynamicPages[dynamicPageType];

export function getStaticPaths() {
    const types = Object.keys(dynamicPages) as (keyof typeof dynamicPages)[];
    const paths = types.map((type) => ({
        params: { dynamicPageType: type },
    }));
    return paths;
}

type EntryRow = {
    year: string;
    slug: string;
    page: (typeof pages)[string][string];
};

const allEntries: EntryRow[] = Object.keys(pages)
    .flatMap((year) =>
        Object.keys(pages[year]).map((slug) => ({
            year,
            slug,
            page: pages[year][slug],
        })),
    )
    .sort(
        (a, b) =>
            new Date(b.page.date).getTime() - new Date(a.page.date).getTime(),
    );

const [feature, ...rest] = allEntries;
const years = Object.keys(pages).sort().reverse();
const total = allEntries.length;
const pageTitle = dynamicPagesConfig[dynamicPageType].title;
const pageLabel = dynamicPageType === "portfolio" ? "portfolio" : "posts";

function fmtDate(iso: string): string {
    const d = new Date(iso);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}·${m}·${day}`;
}

function entryNo(i: number): string {
    return "No. " + String(i + 1).padStart(4, "0");
}
---

<Layout title={pageTitle} cwd={`~/${pageLabel}`}>
    <PageHeader
        title={`${pageTitle}.`}
        bread={[
            { label: "~", href: "/" },
            { label: pageLabel, cwd: true },
        ]}
        filters
    >
        Notes, experiments and mistakes documented in real-time. Some of these
        are useful. Most of them are at least specific.

        <Fragment slot="filters">
            <FilterRow label="// year">
                <Tag href={`/${dynamicPageType}`} variant="amber">
                    all · {total}
                </Tag>
                {
                    years.map((y) => (
                        <Tag href={`/${dynamicPageType}/${y}`}>
                            {y} · {Object.keys(pages[y]).length}
                        </Tag>
                    ))
                }
            </FilterRow>
            <FilterRow label="// sort">
                <Tag variant="amber">newest</Tag>
            </FilterRow>
        </Fragment>
    </PageHeader>

    <StatsStrip>
        <span><strong>{total}</strong> entries</span>
        <span class="sep">·</span>
        <span><strong>{years.length}</strong> years</span>
        <span class="sep">·</span>
        <span>
            last update <strong>{fmtDate(feature.page.date)}</strong>
        </span>
        <span slot="right">{"// scroll · or pick an entry"}</span>
    </StatsStrip>

    {
        feature && (
            <section class="feature-wrap">
                <div class="container-x">
                    <Rule class="mb-rule">
                        <span>{entryNo(0)}</span>
                        <span>· featured · most recent ·</span>
                        <span>{fmtDate(feature.page.date)}</span>
                    </Rule>
                </div>
                <FeatureCard
                    href={`/${dynamicPageType}/${feature.year}/${feature.slug}`}
                    title={feature.page.title}
                    summary={feature.page.summary}
                    date={fmtDate(feature.page.date)}
                    poster={feature.page.poster}
                    idBadge={`${entryNo(0)} · LATEST`}
                    secondary={feature.year}
                />
            </section>
        )
    }

    {
        rest.length > 0 && (
            <section class="grid-wrap">
                <div class="container-x">
                    <Rule class="mb-rule">
                        <span>
                            {entryNo(1)} — {entryNo(rest.length)}
                        </span>
                        <span>
                            · archive · {rest.length} entries ·
                        </span>
                        <span>desc</span>
                    </Rule>
                </div>
                <PostsGrid>
                    {rest.map((entry, i) => (
                        <PostCard
                            href={`/${dynamicPageType}/${entry.year}/${entry.slug}`}
                            title={entry.page.title}
                            excerpt={entry.page.summary}
                            date={fmtDate(entry.page.date)}
                            poster={entry.page.poster}
                            idBadge={entryNo(i + 1)}
                            secondary={entry.year}
                        />
                    ))}
                </PostsGrid>
            </section>
        )
    }
</Layout>

<style>
    .feature-wrap {
        margin-top: var(--s-6);
        padding: 0 var(--gutter);
    }
    .grid-wrap {
        margin-top: var(--s-6);
        padding: 0 var(--gutter) var(--s-8);
    }
    .feature-wrap .container-x,
    .grid-wrap .container-x {
        padding: 0;
    }
    :global(.mb-rule) {
        margin-bottom: 18px;
    }
</style>
