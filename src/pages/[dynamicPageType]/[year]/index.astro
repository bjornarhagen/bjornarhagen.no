---
import Layout from "@/layouts/Layout.astro";
import { dynamicPages, dynamicPagesConfig } from "@/data/dynamic-pages";
import PageHeader from "@/components/dumb/PageHeader.astro";
import Rule from "@/components/dumb/Rule.astro";
import PostsGrid from "@/components/dumb/PostsGrid.astro";
import PostCard from "@/components/dumb/PostCard.astro";

export function getStaticPaths() {
    const types = Object.keys(dynamicPages) as (keyof typeof dynamicPages)[];
    return types.flatMap((type) =>
        Object.keys(dynamicPages[type]).map((year) => ({
            params: { dynamicPageType: type, year },
        })),
    );
}

const { dynamicPageType, year } = Astro.params;
const yearPages = dynamicPages[dynamicPageType][year];
const pageTitle = dynamicPagesConfig[dynamicPageType].title;
const pageLabel = dynamicPageType === "portfolio" ? "portfolio" : "posts";

const entries = Object.keys(yearPages)
    .map((slug) => ({ slug, page: yearPages[slug] }))
    .sort(
        (a, b) =>
            new Date(b.page.date).getTime() - new Date(a.page.date).getTime(),
    );

function fmtDate(iso: string): string {
    const d = new Date(iso);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}·${m}·${day}`;
}
---

<Layout title={`${pageTitle} / ${year}`} cwd={`~/${pageLabel}/${year}`}>
    <PageHeader
        title={`${year}.`}
        bread={[
            { label: "~", href: "/" },
            { label: pageLabel, href: `/${dynamicPageType}` },
            { label: year, cwd: true },
        ]}
    >
        {entries.length} entries from {year}. Filter by clicking a different
        year, or go back to <a href={`/${dynamicPageType}`}>all {pageLabel}</a>.
    </PageHeader>

    <section class="grid-wrap">
        <div class="container-x">
            <Rule class="mb-rule">
                <span>archive · {year}</span>
                <span>· {entries.length} entries ·</span>
                <span>desc</span>
            </Rule>
        </div>
        <PostsGrid>
            {
                entries.map((entry, i) => (
                    <PostCard
                        href={`/${dynamicPageType}/${year}/${entry.slug}`}
                        title={entry.page.title}
                        excerpt={entry.page.summary}
                        date={fmtDate(entry.page.date)}
                        poster={entry.page.poster}
                        idBadge={`No. ${String(i + 1).padStart(4, "0")}`}
                        secondary={year}
                    />
                ))
            }
        </PostsGrid>
    </section>
</Layout>

<style>
    .grid-wrap {
        margin-top: var(--s-6);
        padding: 0 var(--gutter) var(--s-8);
    }
    .grid-wrap .container-x {
        padding: 0;
    }
    :global(.mb-rule) {
        margin-bottom: 18px;
    }
</style>
