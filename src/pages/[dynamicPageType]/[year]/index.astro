---
import { dynamicPages, dynamicPagesConfig } from "../../../data/dynamic-pages";
import Layout from "../../../layouts/Layout.astro";
import { checkIfImageUrl } from "../../../utils/image";

export function getStaticPaths() {
    const types = Object.keys(dynamicPages) as (keyof typeof dynamicPages)[];
    const paths = types.flatMap((type) =>
        Object.keys(dynamicPages[type]).map((year) => ({
            params: {
                dynamicPageType: type,
                year: year,
            },
        })),
    );
    return paths;
}

const { dynamicPageType, year } = Astro.params;
const yearPages = dynamicPages[dynamicPageType][year];
const pageTitle = dynamicPagesConfig[dynamicPageType].title;
const pageLabel = dynamicPageType === "portfolio" ? "portfolio" : "posts";

const entries = Object.keys(yearPages)
    .map((slug) => ({ slug, page: yearPages[slug] }))
    .sort(
        (a, b) =>
            new Date(b.page.date).getTime() - new Date(a.page.date).getTime(),
    );

function fmtDate(iso: string): string {
    const d = new Date(iso);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}·${m}·${day}`;
}
---

<Layout title={`${pageTitle} / ${year}`} cwd={`~/${pageLabel}/${year}`}>
    <section class="header-block">
        <div>
            <div class="bread">
                <a href="/">~</a><span class="sep">/</span>
                <a href={`/${dynamicPageType}`}>{pageLabel}</a>
                <span class="sep">/</span>
                <span class="cwd">{year}</span>
                <span class="caret"></span>
            </div>
            <h1 class="page-title">{year}.</h1>
            <p class="lede">
                {entries.length} entries from {year}. Filter by clicking a
                different year, or go back to <a href={`/${dynamicPageType}`}
                    >all {pageLabel}</a
                >.
            </p>
        </div>
    </section>

    <section class="grid-wrap">
        <div class="container-x">
            <div class="rule">
                <span>archive · {year}</span>
                <span>· {entries.length} entries ·</span>
                <span>desc</span>
            </div>
        </div>
        <div class="posts-grid">
            {
                entries.map((entry, i) => (
                    <a
                        href={`/${dynamicPageType}/${year}/${entry.slug}`}
                        class="post-card"
                    >
                        <div class="post-thumb">
                            {checkIfImageUrl(entry.page.poster) ? (
                                <img
                                    src={entry.page.poster}
                                    alt={entry.page.title}
                                    loading="lazy"
                                />
                            ) : (
                                <div class="img-fallback halftone" />
                            )}
                            <div class="id-badge">
                                No. {String(i + 1).padStart(4, "0")}
                            </div>
                            <div class="date-badge">
                                {fmtDate(entry.page.date)}
                            </div>
                        </div>
                        <div class="post-meta">
                            <span>{fmtDate(entry.page.date)}</span>
                            <span class="sep">·</span>
                            <span class="reading">{year}</span>
                        </div>
                        <h3 class="post-title">{entry.page.title}</h3>
                        <p class="post-excerpt">{entry.page.summary}</p>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .header-block {
        padding: var(--s-8) var(--gutter) var(--s-7);
        border-bottom: 1px solid var(--border-token);
        max-width: var(--max-w);
        margin: 0 auto;
    }
    @media (max-width: 720px) {
        .header-block {
            padding: var(--s-7) var(--gutter) var(--s-6);
        }
    }
    .page-title {
        font-size: clamp(64px, 12vw, 144px);
        line-height: 0.9;
    }
    .lede {
        margin-top: var(--s-4);
        font:
            400 var(--t-body-lg) / 1.5 var(--font-body);
        color: var(--fg-1);
        max-width: 56ch;
    }
    .bread {
        margin-bottom: 20px;
    }
    .lede a {
        color: var(--amber);
        border-bottom: 1px solid
            color-mix(in srgb, var(--amber) 40%, transparent);
    }
    .lede a:hover {
        color: var(--fg);
        border-bottom-color: var(--fg);
        text-decoration: none;
    }

    .grid-wrap {
        margin-top: var(--s-6);
        padding: 0 var(--gutter) var(--s-8);
    }
    .grid-wrap .container-x {
        padding: 0;
    }
    .grid-wrap .rule {
        margin-bottom: 18px;
    }
    .posts-grid {
        max-width: var(--max-w);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border: 1px solid var(--border-token);
    }
    @media (max-width: 960px) {
        .posts-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 640px) {
        .posts-grid {
            grid-template-columns: 1fr;
        }
    }
    .post-card {
        padding: 20px;
        border-right: 1px solid var(--border-token);
        border-bottom: 1px solid var(--border-token);
        background: var(--bg);
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        gap: 14px;
        position: relative;
        transition: background 0.2s;
        text-decoration: none;
        color: inherit;
    }
    .post-card:hover {
        background: var(--bg-1);
        text-decoration: none;
    }
    .post-card:hover .post-title {
        color: var(--amber);
    }
    .post-card:nth-child(3n) {
        border-right: none;
    }
    @media (max-width: 960px) {
        .post-card:nth-child(3n) {
            border-right: 1px solid var(--border-token);
        }
        .post-card:nth-child(2n) {
            border-right: none;
        }
    }
    @media (max-width: 640px) {
        .post-card {
            border-right: none !important;
        }
    }
    .post-thumb {
        aspect-ratio: 16/9;
        background: var(--bg-1);
        border: 1px solid var(--border-token);
        position: relative;
        overflow: hidden;
    }
    .post-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: grayscale(1) contrast(1.05);
    }
    .img-fallback {
        width: 100%;
        height: 100%;
    }
    .post-thumb::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(
            0deg,
            transparent 0 2px,
            rgba(0, 0, 0, 0.16) 2px 3px
        );
    }
    .id-badge,
    .date-badge {
        position: absolute;
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        padding: 4px 8px;
        border: 1px solid var(--border-token);
        z-index: 2;
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }
    .id-badge {
        top: 8px;
        left: 8px;
        color: var(--fg-dim);
    }
    .date-badge {
        bottom: 8px;
        right: 8px;
        color: var(--fg);
    }
    .post-meta {
        display: flex;
        gap: 12px;
        align-items: center;
        font:
            400 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-muted);
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }
    .post-meta .sep {
        color: var(--fg-faint);
    }
    .post-meta .reading {
        color: var(--fg-dim);
    }
    .post-title {
        font:
            400 32px / 1 var(--font-display);
        color: var(--fg);
        transition: color 0.15s;
        letter-spacing: 0.01em;
    }
    .post-excerpt {
        font:
            400 14px / 1.55 var(--font-body);
        color: var(--fg-1);
        max-height: 4.2em;
        overflow: hidden;
        margin: 0;
    }
</style>
