---
import Layout from "@/layouts/Layout.astro";
import ContentRenderer from "@/components/dumb/ContentRenderer.astro";
import { dynamicPages, dynamicPagesConfig } from "@/data/dynamic-pages";
import { checkIfImageUrl } from "@/utils/image";
import PostHead from "@/components/dumb/PostHead.astro";
import PostHero from "@/components/dumb/PostHero.astro";
import Rule from "@/components/dumb/Rule.astro";
import Stat from "@/components/dumb/Stat.astro";
import RelatedRow from "@/components/dumb/RelatedRow.astro";
import RelCell from "@/components/dumb/RelCell.astro";
import Signoff from "@/components/dumb/Signoff.astro";

export function getStaticPaths() {
    const types = Object.keys(dynamicPages) as (keyof typeof dynamicPages)[];
    return types.flatMap((type) =>
        Object.keys(dynamicPages[type]).flatMap((year) =>
            Object.keys(dynamicPages[type][year]).map((slug) => ({
                params: { dynamicPageType: type, year, slug },
            })),
        ),
    );
}

const { dynamicPageType, year, slug } = Astro.params;

if (!dynamicPages[dynamicPageType]?.[year]?.[slug]) {
    return new Response("Not found", { status: 404 });
}

const page = dynamicPages[dynamicPageType][year][slug];
const pageTitle = dynamicPagesConfig[dynamicPageType].title;
const pageLabel = dynamicPageType === "portfolio" ? "portfolio" : "posts";

function fmtDate(iso: string): string {
    const d = new Date(iso);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}·${m}·${day}`;
}

const allEntries = Object.keys(dynamicPages[dynamicPageType])
    .flatMap((y) =>
        Object.keys(dynamicPages[dynamicPageType][y]).map((s) => ({
            year: y,
            slug: s,
            page: dynamicPages[dynamicPageType][y][s],
        })),
    )
    .sort(
        (a, b) =>
            new Date(b.page.date).getTime() - new Date(a.page.date).getTime(),
    );

const currentIndex = allEntries.findIndex(
    (e) => e.year === year && e.slug === slug,
);
const newer = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const older =
    currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;

const allText = (page.content || [])
    .flatMap((section: any) => section.text || [])
    .join(" ");
const wordCount = allText.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(wordCount / 200));

const date = fmtDate(page.date);
const wordsFmt = wordCount.toLocaleString("en-US");
---

<Layout
    title={`${page.title} | ${pageTitle}`}
    description={page.summary}
    image={page.poster}
    cwd={`~/${pageLabel}/${year}/${slug}`}
>
    <PostHead
        bread={[
            { label: "~", href: "/" },
            { label: pageLabel, href: `/${dynamicPageType}` },
            { label: year, href: `/${dynamicPageType}/${year}`, dim: true },
            { label: slug, cwd: true },
        ]}
        title={page.title}
        ruleParts={[
            `entry ${currentIndex === 0 ? "· latest" : ""}`,
            `· ${date}`,
            year,
        ]}
        metas={[
            { k: "date", v: date },
            { k: "read", v: `${readMin} min` },
            { k: "words", v: wordsFmt },
        ]}
        type={pageLabel}
    />

    {
        checkIfImageUrl(page.imageHeader) && (
            <PostHero
                src={page.imageHeader}
                alt={page.title}
                tl={slug}
                tr="FIG. 01"
                bl="// COVER"
                br={date}
            />
        )
    }

    <section class="post-layout">
        <aside class="side side-left">
            <div class="lbl">// meta</div>
            <div class="stack">
                <Stat label="date" value={date} />
                <Stat label="read time" value={`${readMin} min`} />
                <Stat label="words" value={wordsFmt} />
            </div>

            <div class="lbl spaced">// navigate</div>
            <div class="share-links">
                <a href={`/${dynamicPageType}`}>→ back to {pageLabel}</a>
                <a href={`/${dynamicPageType}/${year}`}>→ year {year}</a>
                {
                    newer && (
                        <a
                            href={`/${dynamicPageType}/${newer.year}/${newer.slug}`}
                        >
                            → newer entry
                        </a>
                    )
                }
                {
                    older && (
                        <a
                            href={`/${dynamicPageType}/${older.year}/${older.slug}`}
                        >
                            → older entry
                        </a>
                    )
                }
            </div>
        </aside>

        <article class="prose article-body">
            <p class="lead">{page.summary}</p>
            <ContentRenderer content={page.content} />
        </article>

        <aside class="side side-right">
            <Rule class="side-rule"><span>meta</span></Rule>
            <div class="stack">
                <div class="lbl">// stats</div>
                <Stat label="words" value={wordsFmt} />
                <Stat label="read time" value={`${readMin} min`} />
                <Stat label="year" value={year} />
            </div>
        </aside>
    </section>

    <section class="post-foot">
        <div class="container-x">
            <Rule class="foot-rule">
                <span>EOF</span>
                <span>· next entries ·</span>
                <span>0xHB</span>
            </Rule>
            {
                (newer || older) && (
                    <RelatedRow>
                        {newer ? (
                            <RelCell
                                href={`/${dynamicPageType}/${newer.year}/${newer.slug}`}
                                label="← newer"
                                title={newer.page.title}
                                meta={`${fmtDate(newer.page.date)} · ${newer.year}`}
                            />
                        ) : (
                            <RelCell
                                label="← newer"
                                title="— start of feed"
                                empty
                            />
                        )}
                        <RelCell
                            href={`/${dynamicPageType}`}
                            label="↑ index"
                            title={`All ${pageLabel}`}
                            meta={`${allEntries.length} entries`}
                        />
                        {older ? (
                            <RelCell
                                href={`/${dynamicPageType}/${older.year}/${older.slug}`}
                                label="older →"
                                title={older.page.title}
                                meta={`${fmtDate(older.page.date)} · ${older.year}`}
                            />
                        ) : (
                            <RelCell
                                label="older →"
                                title="— end of feed"
                                empty
                            />
                        )}
                    </RelatedRow>
                )
            }
            <Signoff date={date} />
        </div>
    </section>
</Layout>

<style>
    .post-layout {
        max-width: 1240px;
        margin: 0 auto;
        padding: var(--s-7) var(--gutter) var(--s-9);
        display: grid;
        grid-template-columns: 220px 1fr 240px;
        gap: var(--s-7);
        align-items: start;
    }
    @media (max-width: 1100px) {
        .post-layout {
            grid-template-columns: 1fr;
            gap: var(--s-5);
        }
        .side {
            display: none;
        }
    }

    .side {
        position: sticky;
        top: 56px;
        padding-top: 2px;
    }
    .lbl {
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-dim);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        margin-bottom: 14px;
    }
    .lbl.spaced {
        margin-top: 32px;
    }
    .stack {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .share-links {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font:
            400 13px / 1.4 var(--font-mono);
    }
    .share-links a {
        color: var(--fg-1);
        text-decoration: none;
    }
    .share-links a:hover {
        color: var(--amber);
    }
    :global(.side-rule) {
        margin-bottom: 14px;
    }

    .article-body {
        max-width: 100%;
        min-width: 0;
    }
    .article-body .lead {
        font-size: 19px;
        color: var(--fg);
        max-width: 64ch;
        margin-bottom: 1.5em;
    }
    .article-body :global(.content-renderer-section) {
        margin: 0;
        max-width: 100%;
    }
    .article-body :global(.content-renderer-section section) {
        padding: 0;
        margin: 0;
        gap: var(--s-5);
    }

    .post-foot {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 var(--gutter) var(--s-8);
    }
    .post-foot .container-x {
        padding: 0;
    }
    :global(.foot-rule) {
        margin-bottom: 18px;
    }
</style>
