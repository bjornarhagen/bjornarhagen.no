---
import { readdirSync } from "fs";
import { resolve } from "path";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/dumb/PageHeader.astro";
import StatsStrip from "@/components/dumb/StatsStrip.astro";
import Rule from "@/components/dumb/Rule.astro";
import PostsGrid from "@/components/dumb/PostsGrid.astro";
import PostCard from "@/components/dumb/PostCard.astro";
import Icon from "@/components/dumb/Icon.astro";
import { Search as SearchIcon } from "lucide";
import { dynamicPages, type PageContent } from "@/data/dynamic-pages";
import { entryCatalog, entryKey, fmtNo } from "@/utils/entries";

export const prerender = false;

const url = new URL(Astro.request.url);
const search = (url.searchParams.get("q") ?? "").trim();
const q = search.toLowerCase();

const cat = entryCatalog("entries");

type Hit = { year: string; slug: string; page: PageContent };

const entryHits: Hit[] = q
    ? Object.keys(dynamicPages.entries)
          .flatMap((year) =>
              Object.keys(dynamicPages.entries[year])
                  .map((slug) => ({
                      year,
                      slug,
                      page: dynamicPages.entries[year][slug],
                  }))
                  .filter(
                      ({ page }) =>
                          page.title.toLowerCase().includes(q) ||
                          page.summary.toLowerCase().includes(q),
                  ),
          )
          .sort(
              (a, b) =>
                  new Date(b.page.date).getTime() -
                  new Date(a.page.date).getTime(),
          )
    : [];

function fmtDate(iso: string): string {
    const d = new Date(iso);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}·${m}·${day}`;
}

// Dev-only: also surface top-level pages by name.
function getRootRoutes(): { path: string; title: string }[] {
    if (process.env.NODE_ENV === "production") return [];
    const pagesDir = resolve("./src/pages");
    const hidden = [
        "search",
        "kitchen-sink",
        "editor",
        "editor-load-entry",
        "editor-api",
        "portfolio-tmp",
    ];
    return readdirSync(pagesDir)
        .filter((file) => file.endsWith(".astro"))
        .map((file) => file.replace(".astro", ""))
        .filter((path) => !hidden.includes(path))
        .map((path) =>
            path === "index"
                ? { path: "/", title: "Home" }
                : { path: `/${path}`, title: path.replace(/-/g, " ") },
        );
}

const pageHits = q
    ? getRootRoutes().filter(
          (p) =>
              p.title.toLowerCase().includes(q) ||
              p.path.toLowerCase().includes(q),
      )
    : [];

const totalHits = entryHits.length + pageHits.length;
---

<Layout title={search ? `${search} — Search` : "Search"} cwd="~/search">
    <PageHeader
        title="Search."
        bread={[
            { label: "~", href: "/" },
            { label: "search", cwd: true },
        ]}
        filters
    >
        Grep the site — posts matched by title and summary.

        <Fragment slot="filters">
            <form class="search-form" action="/search" role="search">
                <span class="prompt">›</span>
                <input
                    name="q"
                    type="search"
                    value={search}
                    placeholder="grep site ..."
                    autofocus
                    aria-label="Search query"
                />
                <button type="submit" class="btn primary">
                    <Icon icon={SearchIcon} />
                    <span>Search</span>
                </button>
            </form>
        </Fragment>
    </PageHeader>

    {
        search && (
            <StatsStrip>
                <span>
                    <strong>{totalHits}</strong>{" "}
                    {totalHits === 1 ? "result" : "results"}
                </span>
                <span class="sep">·</span>
                <span>
                    query <strong>{search}</strong>
                </span>
                <span slot="right">{`// ${entryHits.length} posts`}</span>
            </StatsStrip>
        )
    }

    <section class="results">
        {
            !search && (
                <div class="container-x empty">
                    <p>Type a query above to search posts.</p>
                </div>
            )
        }

        {
            search && totalHits === 0 && (
                <div class="container-x empty">
                    <p>
                        No matches for <strong>{search}</strong>. Try a broader
                        term.
                    </p>
                </div>
            )
        }

        {
            entryHits.length > 0 && (
                <div class="block">
                    <div class="container-x">
                        <Rule class="mb-rule">
                            <span>posts</span>
                            <span>· {entryHits.length} ·</span>
                            <span>matches</span>
                        </Rule>
                    </div>
                    <PostsGrid>
                        {entryHits.map((hit) => (
                            <PostCard
                                href={`/entries/${hit.year}/${hit.slug}`}
                                title={hit.page.title}
                                excerpt={hit.page.summary}
                                date={fmtDate(hit.page.date)}
                                poster={hit.page.poster}
                                idBadge={fmtNo(
                                    cat.numberByKey.get(
                                        entryKey(hit.year, hit.slug),
                                    ),
                                )}
                                secondary={hit.year}
                            />
                        ))}
                    </PostsGrid>
                </div>
            )
        }

        {
            pageHits.length > 0 && (
                <div class="block">
                    <div class="container-x">
                        <Rule class="mb-rule">
                            <span>pages</span>
                            <span>· {pageHits.length} ·</span>
                            <span>matches</span>
                        </Rule>
                        <ul class="page-list">
                            {pageHits.map((p) => (
                                <li>
                                    <a href={p.path}>{p.title}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            )
        }
    </section>
</Layout>

<style>
    .search-form {
        display: flex;
        gap: var(--s-3);
        align-items: center;
        border: 1px solid var(--border-strong);
        background: var(--bg-1);
        padding: 0 12px;
        height: 48px;
        min-width: 320px;
    }
    .search-form .prompt {
        color: var(--amber);
        font:
            500 var(--t-mono-md) / 1 var(--font-mono);
    }
    .search-form input {
        flex: 1;
        min-width: 0;
        background: transparent;
        border: 0;
        outline: 0;
        color: var(--fg);
        font:
            400 var(--t-mono-md) / 1 var(--font-mono);
    }
    .results {
        padding: var(--s-6) 0 var(--s-9);
    }
    .block {
        margin-bottom: var(--s-7);
    }
    .block .container-x {
        padding-left: var(--gutter);
        padding-right: var(--gutter);
    }
    .empty {
        font:
            400 var(--t-mono-base) / 1.6 var(--font-mono);
        color: var(--fg-dim);
        padding-top: var(--s-7);
        padding-bottom: var(--s-7);
    }
    .empty strong {
        color: var(--fg);
    }
    .page-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        font:
            500 var(--t-mono-sm) / 1.6 var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }
    :global(.mb-rule) {
        margin-bottom: 18px;
    }
</style>
