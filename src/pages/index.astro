---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
    <section class="hero">
        <div class="hero-left">
            <div class="rule mb-rule">
                <span>identity</span>
                <span>· 01 ·</span>
                <span>operator profile</span>
            </div>

            <h1 class="hero-title">
                <span>Bj&oslash;rnar</span><br />
                <span>Hagen</span><span class="dot">.</span>
            </h1>
            <div class="role">
                // Software Engineer &nbsp;·&nbsp; Builder &nbsp;·&nbsp; Bear-adjacent
            </div>

            <p class="lede">
                I build, break and occasionally fix systems on the open web —
                full-stack, infrastructure, the slightly haunted parts in
                between. Currently shipping software at
                <a
                    href="https://gokstadakademiet.no/?ref=bjornar.dev"
                    target="_blank"
                    rel="noopener">Gokstad Akademiet</a
                >, and quietly maintaining
                <a
                    href="https://nuva.no/?ref=bjornar.dev"
                    target="_blank"
                    rel="noopener">NUVA</a
                >.
            </p>

            <div class="cta-row">
                <a href="/entries" class="btn primary">
                    <span>Read posts</span><span class="arrow"></span>
                </a>
                <a href="/portfolio-tmp" class="btn">
                    <span>Portfolio</span><span class="arrow"></span>
                </a>
                <a href="mailto:post@bjornarhagen.no" class="btn">
                    <span>Contact</span><span class="arrow tr"></span>
                </a>
            </div>

            <div class="meta-grid">
                <div>
                    <div class="kv"><span class="k">Active</span></div>
                    <div class="meta-v ok">14y · 02mo</div>
                </div>
                <div>
                    <div class="kv"><span class="k">Posted</span></div>
                    <div class="meta-v">@ Gokstad</div>
                </div>
                <div>
                    <div class="kv"><span class="k">Stack</span></div>
                    <div class="meta-v">TS · PHP · Astro</div>
                </div>
                <div>
                    <div class="kv"><span class="k">Based</span></div>
                    <div class="meta-v">Sandefjord, NO</div>
                </div>
            </div>
        </div>

        <aside class="dossier" aria-label="Operator dossier">
            <div class="head">
                <span>
                    <span class="head-dot"></span> DOSSIER / 0xHB
                </span>
                <span>FILE No. 009X·B</span>
            </div>
            <div class="body">
                <div class="portrait">
                    <svg
                        class="portrait-svg"
                        viewBox="0 0 220 320"
                        preserveAspectRatio="xMidYMid slice"
                        aria-hidden="true"
                    >
                        <defs>
                            <pattern
                                id="halftone-dense"
                                width="3"
                                height="3"
                                patternUnits="userSpaceOnUse"
                            >
                                <circle
                                    cx="1.5"
                                    cy="1.5"
                                    r="1.05"
                                    fill="var(--fg)"></circle>
                            </pattern>
                            <pattern
                                id="halftone-mid"
                                width="4"
                                height="4"
                                patternUnits="userSpaceOnUse"
                            >
                                <circle
                                    cx="2"
                                    cy="2"
                                    r=".85"
                                    fill="var(--fg)"></circle>
                            </pattern>
                            <pattern
                                id="halftone-sparse"
                                width="6"
                                height="6"
                                patternUnits="userSpaceOnUse"
                            >
                                <circle
                                    cx="3"
                                    cy="3"
                                    r=".7"
                                    fill="var(--fg-dim)"></circle>
                            </pattern>
                            <pattern
                                id="halftone-vsparse"
                                width="8"
                                height="8"
                                patternUnits="userSpaceOnUse"
                            >
                                <circle
                                    cx="4"
                                    cy="4"
                                    r=".5"
                                    fill="var(--fg-muted)"></circle>
                            </pattern>
                            <radialGradient
                                id="vignette"
                                cx=".5"
                                cy=".4"
                                r=".7"
                            >
                                <stop
                                    offset=".3"
                                    stop-color="var(--bg)"
                                    stop-opacity="0"></stop>
                                <stop
                                    offset="1"
                                    stop-color="var(--bg)"
                                    stop-opacity=".8"></stop>
                            </radialGradient>
                        </defs>
                        <rect
                            width="220"
                            height="320"
                            fill="var(--bg)"></rect>
                        <rect
                            width="220"
                            height="320"
                            fill="url(#halftone-vsparse)"
                            opacity=".7"></rect>
                        <g transform="translate(110 170)">
                            <ellipse
                                cx="0"
                                cy="60"
                                rx="100"
                                ry="80"
                                fill="url(#halftone-sparse)"
                                opacity=".7"></ellipse>
                            <ellipse
                                cx="0"
                                cy="60"
                                rx="86"
                                ry="70"
                                fill="url(#halftone-mid)"
                                opacity=".75"></ellipse>
                            <ellipse
                                cx="0"
                                cy="60"
                                rx="60"
                                ry="50"
                                fill="url(#halftone-dense)"
                                opacity=".55"></ellipse>
                            <circle
                                cx="0"
                                cy="-20"
                                r="62"
                                fill="url(#halftone-sparse)"
                                opacity=".75"></circle>
                            <circle
                                cx="0"
                                cy="-20"
                                r="50"
                                fill="url(#halftone-mid)"
                                opacity=".8"></circle>
                            <circle
                                cx="0"
                                cy="-20"
                                r="38"
                                fill="url(#halftone-dense)"
                                opacity=".55"></circle>
                            <circle
                                cx="-44"
                                cy="-58"
                                r="16"
                                fill="url(#halftone-mid)"
                                opacity=".9"></circle>
                            <circle
                                cx="44"
                                cy="-58"
                                r="16"
                                fill="url(#halftone-mid)"
                                opacity=".9"></circle>
                            <circle
                                cx="-44"
                                cy="-58"
                                r="10"
                                fill="url(#halftone-dense)"
                                opacity=".7"></circle>
                            <circle
                                cx="44"
                                cy="-58"
                                r="10"
                                fill="url(#halftone-dense)"
                                opacity=".7"></circle>
                            <ellipse
                                cx="0"
                                cy="10"
                                rx="22"
                                ry="16"
                                fill="url(#halftone-mid)"
                                opacity=".95"></ellipse>
                            <ellipse
                                cx="0"
                                cy="6"
                                rx="6"
                                ry="4"
                                fill="var(--bg)"></ellipse>
                            <circle cx="-16" cy="-26" r="2.4" fill="var(--bg)"
                            ></circle>
                            <circle cx="16" cy="-26" r="2.4" fill="var(--bg)"
                            ></circle>
                        </g>
                        <rect
                            width="220"
                            height="320"
                            fill="url(#vignette)"></rect>
                        <g stroke="var(--fg)" stroke-width="1" fill="none">
                            <path d="M8 8 h14 M8 8 v14"></path>
                            <path d="M212 8 h-14 M212 8 v14"></path>
                            <path d="M8 312 h14 M8 312 v-14"></path>
                            <path d="M212 312 h-14 M212 312 v-14"></path>
                        </g>
                        <g
                            stroke="var(--amber)"
                            stroke-width="1"
                            fill="none"
                            opacity=".7"
                        >
                            <circle cx="110" cy="150" r="22"></circle>
                            <path
                                d="M110 116 v18 M110 184 v-18 M76 150 h18 M144 150 h-18"
                            ></path>
                        </g>
                    </svg>
                </div>
                <div class="data">
                    <div class="row">
                        <span class="k">codename</span>
                        <span class="v">ursa<span class="under">_</span>major</span>
                    </div>
                    <div class="row">
                        <span class="k">class</span>
                        <span class="v">full-stack engineer</span>
                    </div>
                    <div class="row">
                        <span class="k">based</span>
                        <span class="v">Sandefjord, NO</span>
                    </div>
                    <div class="row">
                        <span class="k">origin</span>
                        <span class="v">Larvik, NO</span>
                    </div>
                    <div class="row">
                        <span class="k">posted</span>
                        <span class="v">Gokstad Akademiet</span>
                    </div>
                    <div class="row">
                        <span class="k">stack</span>
                        <span class="v">TS · PHP · Astro · Laravel</span>
                    </div>
                    <div class="row">
                        <span class="k">channels</span>
                        <span class="v">GH · LinkedIn · @</span>
                    </div>
                    <div class="row">
                        <span class="k">clearance</span>
                        <span class="v amber">★★★★☆</span>
                    </div>
                </div>
            </div>
            <div class="foot">
                <span>ENCRYPTED · TLS 1.3</span>
                <span class="signal-bars" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span
                    ></span>
                </span>
                <span>UPLINK ▲ 1.2GB/s</span>
            </div>
        </aside>
    </section>

    <!-- 01 PERSONAL -->
    <section class="section">
        <div class="inner">
            <div class="numhead">
                <div class="num">01</div>
                <div class="lbl">Personal</div>
                <div class="sub">// who is HB</div>
            </div>
            <div class="text">
                <p>
                    Born and raised in Larvik, Norway. Currently living in
                    Sandefjord.
                </p>
                <p>
                    I&rsquo;ve always loved building and taking things apart,
                    so when I at a young age was introduced to computers, it
                    didn&rsquo;t take very long before I was taking them apart
                    and learning about how they worked. When I was 14 I saved
                    up scholarship money originally meant for school equipment
                    to instead buy computer parts so I could build my first
                    desktop computer. Once I had that built, I started learning
                    about code and software. I was instantly fascinated with
                    the web technologies and building websites. Since then
                    I&rsquo;ve learnt more and more about programming and
                    different software technologies.
                </p>
            </div>
        </div>
    </section>

    <!-- 02 CAREER -->
    <section class="section">
        <div class="inner">
            <div class="numhead">
                <div class="num">02</div>
                <div class="lbl">Career</div>
                <div class="sub">// 14 years &amp; counting</div>
            </div>
            <div class="text">
                <p>
                    I learnt HTML, CSS, JS and PHP through self study and got
                    a few gigs through some close friends. Later on I got my
                    first &ldquo;real job&rdquo; as an apprentice at Optimale
                    Systemer in Larvik. Around the same time I started the
                    company Datahjelpen so to take on extra jobs outside of
                    work and school.
                </p>
                <p>
                    After 2 years at Optimale Systemer I had learned a lot and
                    considered myself a full-stack web developer, though still
                    very much a junior. I now knew how to setup the LEMP stack
                    from scratch on a VPS, and I could make both the front-end
                    and back-end of a webapp. After this I moved to Halden to
                    start on my Bachelor of Science in Computer Engineering at
                    &Oslash;stfold College University.
                </p>
                <p>
                    3 years later I got my degree and moved to Sandefjord,
                    where I still live. I started working full-time in
                    Datahjelpen. After a good year, Covid unfortunately became
                    a thing. I had to find a more stable job as no one was
                    willing to start new projects at the time. That is how I
                    ended up at Adstate, where I stayed for 4 years.
                </p>
                <p>
                    In 2023 I started
                    <a
                        href="https://nuva.no/?ref=bjornar.dev"
                        target="_blank"
                        rel="noopener">NUVA</a
                    > with a couple of friends.
                </p>
                <p>
                    I&rsquo;m currently working full-time at
                    <a
                        href="https://gokstadakademiet.no/?ref=bjornar.dev"
                        target="_blank"
                        rel="noopener">Gokstad Akademiet</a
                    >.
                </p>
            </div>
        </div>
    </section>

    <!-- 03 WORK LOG -->
    <section class="section">
        <div class="inner full">
            <div class="section-head">
                <div>
                    <h3 class="big-heading">Work log</h3>
                    <div class="sub-heading">
                        // 6 stations · 1 active · current=Gokstad
                    </div>
                </div>
                <div class="rule">
                    <span>14y</span>
                    <span>· timeline ·</span>
                    <span>active</span>
                </div>
            </div>

            <div class="work-grid">
                <div class="work-card active">
                    <div class="co">
                        <span class="status-dot"></span> Gokstad Akademiet AS
                        <span class="when">2025 — now</span>
                    </div>
                    <div class="role-line">IT manager</div>
                    <div class="desc">
                        Currently working full-time. Architecture, mentorship,
                        infrastructure, the occasional 03:00 incident.
                    </div>
                </div>
                <div class="work-card">
                    <div class="co">
                        <span class="status-dot"></span> River Security AS
                        <span class="when">2024 — 2025</span>
                    </div>
                    <div class="role-line">Senior full-stack developer</div>
                    <div class="desc">
                        Continuous offensive security tooling. Spent a lot of
                        time in the parts of the web nobody wants to look at.
                    </div>
                </div>
                <div class="work-card active">
                    <div class="co">
                        <span class="status-dot"></span> NUVA AS
                        <span class="when">2023 — sidegig</span>
                    </div>
                    <div class="role-line">Developer &amp; COB</div>
                    <div class="desc">
                        A still-young SaaS built with two close friends.
                        Lives at nuva.no &amp; saunabooking.no.
                    </div>
                </div>
                <div class="work-card">
                    <div class="co">
                        <span class="status-dot"></span> Rapid Data AS
                        <span class="when">2020 — 2024</span>
                    </div>
                    <div class="role-line">
                        Full-stack developer (formerly Adstate)
                    </div>
                    <div class="desc">
                        Ad-tech and analytics platform work during the pandemic
                        years. Quiet, stable, productive — exactly what that
                        period needed.
                    </div>
                </div>
                <div class="work-card active">
                    <div class="co">
                        <span class="status-dot"></span> Datahjelpen AS
                        <span class="when">2016 — now</span>
                    </div>
                    <div class="role-line">Developer &amp; CEO (part-time)</div>
                    <div class="desc">
                        My own one-person shop. WordPress, Laravel, custom CRMs
                        for local SMBs. The school of &ldquo;how does a real
                        customer think&rdquo;.
                    </div>
                </div>
                <div class="work-card">
                    <div class="co">
                        <span class="status-dot"></span> Optimale Systemer AS
                        <span class="when">2014 — 2016</span>
                    </div>
                    <div class="role-line">Junior developer</div>
                    <div class="desc">
                        Where it started. Tickets, deployments, learning to
                        read other people&rsquo;s code without flinching.
                        Foundational.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 04 NOW -->
    <section class="section">
        <div class="inner full">
            <div class="section-head">
                <div>
                    <h3 class="big-heading">/now</h3>
                    <div class="sub-heading">
                        // what is on the bench this week
                    </div>
                </div>
                <div class="rule">
                    <span>updated</span>
                    <span data-clock>00:00:00 UTC</span>
                    <span>· live</span>
                </div>
            </div>

            <div class="now-strip">
                <div class="now-cell">
                    <div class="ttl">↳ building</div>
                    <div class="ln">Internal SaaS @ Gokstad Akademiet</div>
                    <div class="ln">saunabooking.no — Stripe Connect</div>
                    <div class="ln">this site — v7</div>
                </div>
                <div class="now-cell">
                    <div class="ttl">↳ reading</div>
                    <div class="ln">Designing Data-Intensive Applications</div>
                    <div class="ln">Tidy First? · Kent Beck</div>
                    <div class="ln">A Philosophy of Software Design</div>
                </div>
                <div class="now-cell">
                    <div class="ttl">↳ orbit</div>
                    <div class="ln">Sandefjord, NO</div>
                    <div class="ln">Heavy rotation: Sub Focus</div>
                    <div class="ln">Self-hosting more &amp; more things</div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: var(--s-7);
        padding: var(--s-8) var(--gutter) var(--s-9);
        align-items: stretch;
        border-bottom: 1px solid var(--border-token);
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
    }
    @media (max-width: 960px) {
        .hero {
            grid-template-columns: 1fr;
            gap: var(--s-6);
            padding: var(--s-6) var(--gutter) var(--s-7);
        }
    }
    .mb-rule {
        margin-bottom: 28px;
    }
    .hero-title {
        font-size: clamp(72px, 12vw, 132px);
        line-height: 0.92;
        letter-spacing: 0.005em;
    }
    .hero-title .dot {
        color: var(--amber);
    }
    .role {
        margin-top: var(--s-3);
        font:
            500 var(--t-mono-md) / 1.4 var(--font-mono);
        color: var(--amber);
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }
    .lede {
        margin-top: var(--s-5);
        font-size: 19px;
        line-height: 1.55;
        color: var(--fg-1);
        max-width: 38ch;
    }
    .lede a {
        color: var(--amber);
        border-bottom: 1px solid
            color-mix(in srgb, var(--amber) 40%, transparent);
    }
    .lede a:hover {
        color: var(--fg);
        border-bottom-color: var(--fg);
        text-decoration: none;
    }
    .cta-row {
        display: flex;
        gap: var(--s-3);
        margin-top: var(--s-6);
        flex-wrap: wrap;
    }
    .meta-grid {
        margin-top: var(--s-7);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border: 1px solid var(--border-token);
    }
    @media (max-width: 720px) {
        .meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .meta-grid > div {
        padding: 12px 14px;
        border-right: 1px solid var(--border-token);
        background: var(--bg-1);
    }
    .meta-grid > div:last-child {
        border-right: none;
    }
    @media (max-width: 720px) {
        .meta-grid > div:nth-child(2) {
            border-right: none;
        }
    }
    .meta-v {
        font:
            500 18px / 1 var(--font-mono);
        margin-top: 8px;
        color: var(--fg);
    }
    .meta-v.ok {
        color: var(--ok);
    }

    /* dossier */
    .dossier {
        border: 1px solid var(--border-strong);
        background: var(--bg-1);
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr auto;
    }
    .dossier .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-token);
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-dim);
        text-transform: uppercase;
        letter-spacing: 0.16em;
    }
    .head-dot {
        background: var(--amber);
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 6px;
    }
    .dossier .body {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 0;
    }
    @media (max-width: 540px) {
        .dossier .body {
            grid-template-columns: 1fr;
        }
    }
    .dossier .portrait {
        border-right: 1px solid var(--border-token);
        position: relative;
        overflow: hidden;
    }
    .dossier .portrait-svg {
        width: 100%;
        height: 100%;
        display: block;
    }
    .dossier .portrait::after {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent 0 2px,
            rgba(0, 0, 0, 0.18) 2px 3px
        );
        pointer-events: none;
    }
    .dossier .data {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .dossier .data .row {
        display: grid;
        grid-template-columns: 90px 1fr;
        font:
            400 var(--t-mono-sm) / 1.5 var(--font-mono);
        gap: 8px;
        border-bottom: 1px dashed var(--hairline);
        padding-bottom: 8px;
    }
    .dossier .data .row:last-child {
        border-bottom: none;
    }
    .dossier .data .row .k {
        color: var(--fg-muted);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 11px;
    }
    .dossier .data .row .v {
        color: var(--fg);
    }
    .dossier .data .row .v.amber {
        color: var(--amber);
    }
    .dossier .data .row .v .under {
        color: var(--amber);
    }
    .dossier .foot {
        padding: 8px 14px;
        border-top: 1px solid var(--border-token);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font:
            500 var(--t-mono-xs) / 1 var(--font-mono);
        color: var(--fg-muted);
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }
    .dossier .signal-bars {
        display: flex;
        gap: 2px;
        align-items: flex-end;
    }
    .dossier .signal-bars span {
        width: 3px;
        background: var(--amber);
    }
    .dossier .signal-bars span:nth-child(1) {
        height: 4px;
    }
    .dossier .signal-bars span:nth-child(2) {
        height: 7px;
    }
    .dossier .signal-bars span:nth-child(3) {
        height: 10px;
    }
    .dossier .signal-bars span:nth-child(4) {
        height: 13px;
        background: var(--fg-muted);
    }
    .dossier .signal-bars span:nth-child(5) {
        height: 16px;
        background: var(--fg-faint);
    }

    /* numbered sections */
    .section {
        padding: var(--s-9) var(--gutter);
        border-bottom: 1px solid var(--border-token);
        position: relative;
    }
    @media (max-width: 720px) {
        .section {
            padding: var(--s-7) var(--gutter);
        }
    }
    .section .inner {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: var(--s-7);
        max-width: var(--max-w);
        margin: 0 auto;
    }
    .section .inner.full {
        grid-template-columns: 1fr;
    }
    @media (max-width: 800px) {
        .section .inner {
            grid-template-columns: 1fr;
            gap: var(--s-5);
        }
    }
    .section .text {
        font-size: 17px;
        line-height: 1.7;
        color: var(--fg-1);
        max-width: 64ch;
    }
    .section .text p {
        margin: 0 0 1.1em;
        max-width: none;
    }
    .section .text p:last-child {
        margin-bottom: 0;
    }
    .section .text a {
        color: var(--amber);
        border-bottom: 1px solid
            color-mix(in srgb, var(--amber) 40%, transparent);
    }
    .section .text a:hover {
        color: var(--fg);
        border-bottom-color: var(--fg);
        text-decoration: none;
    }

    .section-head {
        display: flex;
        align-items: baseline;
