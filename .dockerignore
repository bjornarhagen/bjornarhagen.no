# Keep the build context small and free of local build output.
#
# .vercel in particular must never enter the context: a local Vercel build
# writes an Astro server-island key into its manifest, and the directory is
# well over 100 MB.
#
# Note this deliberately does not exclude *.md, because src/pages contains
# real markdown pages that the site renders.

.git
.github
.devcontainer
.vscode
.claude

node_modules
dist
.astro
.vercel

AGENTS.md
CLAUDE.md

.env
.env.*
*.pem
*.key

.DS_Store
Thumbs.db
